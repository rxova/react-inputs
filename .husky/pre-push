#!/usr/bin/env sh
set -e

# The whole hook is `rxova-repo-config pre-push`: it skips a push that only
# deletes refs and otherwise runs the same ordered gate CI runs
# (`repoConfig.verify.steps` in the root package.json), so a green push means a
# green pipeline. Turbo caches unchanged tasks, so re-runs are cheap. E2E is not
# in verify — it runs as its own CI job.
pnpm exec rxova-repo-config pre-push
