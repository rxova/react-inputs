#!/usr/bin/env sh
set -e

# eslint --fix + prettier --write over exactly the staged files.
#
# lint-staged already covers the staged set, so the full-repo `pnpm run lint`
# this line used to carry was duplication.
pnpm exec lint-staged

# The whole-program checks lint-staged cannot do per-file: types are a property
# of the program, not of a file, and a unit test can only fail against the whole
# module graph. Turbo replays both from cache for every package whose inputs are
# byte-identical, so in practice this re-checks only what the commit actually
# touched — without asking git what "changed", which is what keeps it correct
# mid-rebase, after a cherry-pick and on a merge.
#
# `test`, not `test:coverage`: the coverage thresholds need the browser project,
# which is slow enough to push people around the hook. pre-push runs the
# coverage variant, and CI runs it again.
#
# Everything heavier — build, size budgets, audit, dedupe, packaging, e2e —
# stays in pre-push (`repoConfig.verify` in the root package.json) and CI.
pnpm exec turbo run typecheck test
