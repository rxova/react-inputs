{
  "name": "@rxova/codemod",
  "version": "1.0.0",
  "type": "module",
  "description": "jscodeshift codemods for migrating onto the rxova input suite. Run `npx @rxova/codemod <transform> <path>`.",
  "keywords": [
    "codemod",
    "jscodeshift",
    "migration",
    "rxova",
    "input-otp",
    "react-otp-input"
  ],
  "license": "MIT",
  "bin": {
    "rxova-codemod": "./dist/bin.cjs"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "exports": {
    "./transforms/*": {
      "types": "./dist/transforms/*.d.cts",
      "default": "./dist/transforms/*.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "node --import tsx ../utils/codemod-pack-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "jscodeshift": "^17.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^26.1.2",
    "publint": "^0.3.22",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/react-inputs.git",
    "directory": "packages/codemod"
  },
  "homepage": "https://github.com/rxova/react-inputs/tree/main/packages/codemod#readme",
  "bugs": {
    "url": "https://github.com/rxova/react-inputs/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
