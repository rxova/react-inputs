{
  "name": "@rxova/codemod",
  "version": "1.0.2",
  "type": "module",
  "description": "jscodeshift codemods for migrating onto the rxova input suite. Run `npx @rxova/codemod <transform> <path>`.",
  "keywords": [
    "codemod",
    "jscodeshift",
    "migration",
    "rxova",
    "input-otp",
    "react-otp-input",
    "jscodeshift-transform",
    "refactor",
    "automated-migration",
    "react",
    "ast",
    "upgrade"
  ],
  "license": "MIT",
  "bin": {
    "rxova-codemod": "./dist/bin.cjs"
  },
  "files": [
    "dist",
    "llms.txt"
  ],
  "exports": {
    "./transforms/*": {
      "types": "./dist/transforms/*.d.cts",
      "default": "./dist/transforms/*.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "rxova-repo-config pack-smoke",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "jscodeshift": "^17.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/jscodeshift": "^17.3.0",
    "@types/node": "^26.6.1",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "6.0.3",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/react-inputs.git",
    "directory": "packages/codemod"
  },
  "homepage": "https://github.com/rxova/react-inputs/tree/main/packages/codemod#readme",
  "bugs": {
    "url": "https://github.com/rxova/react-inputs/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "repoConfig": {
    "packSmoke": {
      "load": "never",
      "bins": {
        "rxova-codemod": {
          "args": [
            "--help"
          ],
          "expect": "input-otp-to-otp"
        }
      },
      "run": [
        {
          "bin": "rxova-codemod",
          "args": [
            "input-otp-to-otp",
            "fixture.tsx"
          ],
          "fixture": {
            "path": "fixture.tsx",
            "contents": "import { OTPInput } from 'input-otp'\nexport const Example = () => <OTPInput maxLength={6} />\n"
          },
          "expect": [
            "from '@rxova/react-otp-input'",
            "OtpInput"
          ]
        }
      ]
    }
  }
}
