{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"]
  },
  // The .mjs modules stay outside the TS program (component-packages.mjs is
  // imported by plain Node and the Astro config). The root eslint config lints
  // `**/*.ts` with projectService — a .ts file in no program is a parse error,
  // not a silent skip — so every .ts script here is included.
  "include": ["*.ts"]
}
