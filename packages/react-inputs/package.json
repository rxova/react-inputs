{
  "name": "@rxova/react-inputs",
  "version": "1.0.1",
  "type": "module",
  "description": "The complete rxova suite: currency, rating, OTP, password, phone, date, time, tags and file inputs for React from a single install.",
  "keywords": [
    "react",
    "input",
    "inputs",
    "currency",
    "rating",
    "otp",
    "headless",
    "accessible",
    "a11y",
    "rxova"
  ],
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "llms.txt"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@rxova/react-date-input": "workspace:^",
    "@rxova/react-duration-input": "workspace:^",
    "@rxova/react-file-input": "workspace:^",
    "@rxova/react-intl-currency-input": "workspace:^",
    "@rxova/react-otp-input": "workspace:^",
    "@rxova/react-password-input": "workspace:^",
    "@rxova/react-phone-input": "workspace:^",
    "@rxova/react-rating-input": "workspace:^",
    "@rxova/react-tags-input": "workspace:^",
    "@rxova/react-time-input": "workspace:^"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:exports": "publint --strict && attw --pack .",
    "pack:smoke": "node --import tsx ../utils/pack-smoke.ts",
    "size": "size-limit",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@size-limit/preset-small-lib": "^13.0.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "publint": "^0.3.22",
    "react": "^19.2.8",
    "size-limit": "^13.0.3",
    "tsdown": "^0.22.14",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/react-inputs.git",
    "directory": "packages/react-inputs"
  },
  "bugs": {
    "url": "https://github.com/rxova/react-inputs/issues"
  },
  "homepage": "https://rxova.org/packages/react-inputs/"
}
