node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.DS_Store
.turbo/
.vitest-attachments/
.vitest/
# Vitest browser failure screenshots. No visual-regression baselines are
# committed yet; when toMatchScreenshot lands, un-ignore the baseline dir.
**/__screenshots__/
.idea/
.vscode/*
!.vscode/extensions.json
apps/playground/dist/
# Regenerated by starlight-typedoc from the packages' sources on every docs
# build. These paths are the Starlight ones: the rules here used to point at
# `apps/docs/docs/components/*/api/` and `apps/docs/.docusaurus/`, which were
# where Docusaurus put things. The migration moved the content root to
# `src/content/docs`, the old rules silently stopped matching anything, and 38
# generated files plus Astro's private cache got committed as a result.
apps/docs/src/content/docs/components/*/api/
# Astro's own scratch directory — a rebuildable cache, not source. dev.log in
# particular accumulates absolute paths from whichever machine last ran the dev
# server, which has no business in a public repo.
apps/docs/.astro/
test-results/
playwright-report/
.pw-browsers/
pw-browsers/

# Vendor-specific assistant state, none of which belongs in a public repo. The
# deliberate exception is AGENTS.md, which is tracked: one vendor-neutral file
# every tool reads, reviewed like any other doc. Do not add it below.
.claude/
.claude.json
.claude.json.backup
CLAUDE.local.md
