{
  "name": "rxova",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rxova React Inputs: a suite of headless, accessible React input components.",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "size": "turbo run size",
    "check:exports": "turbo run check:exports --concurrency=1",
    "pack:smoke": "turbo run pack:smoke --concurrency=1",
    "audit:check": "pnpm audit --audit-level=high",
    "dedupe:check": "pnpm dedupe --check",
    "dev": "turbo run dev --filter=@rxova/playground",
    "playground:build": "turbo run build --filter=@rxova/playground",
    "storybook": "turbo run dev --filter=@rxova/storybook",
    "storybook:build": "turbo run build --filter=@rxova/storybook",
    "docs": "pnpm run docs:dev",
    "docs:dev": "turbo run dev --filter=@rxova/docs",
    "docs:build": "turbo run build --filter=@rxova/docs",
    "e2e": "turbo run e2e --concurrency=3",
    "e2e:serial": "turbo run e2e --concurrency=1",
    "test:frameworks": "turbo run compat --filter='./apps/compat-*' --concurrency=1",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "release": "turbo run build && changeset publish",
    "postpublish:smoke": "node --import tsx ./packages/utils/post-publish-smoke.ts",
    "prepare": "husky",
    "check:docs": "node --import tsx ./packages/utils/check-doc-snippets.ts",
    "check:llms": "node --import tsx ./packages/utils/check-llms.ts",
    "check:tokens": "node --import tsx ./packages/utils/check-tokens.ts",
    "check:browsers": "node --import tsx ./packages/utils/check-browsers.ts",
    "verify": "node --import tsx ./packages/utils/verify.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "^26.1.2",
    "axe-core": "^4.13.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,astro}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,jsonc,css,md,mdx,yaml,yml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/react-inputs.git"
  },
  "bugs": {
    "url": "https://github.com/rxova/react-inputs/issues"
  },
  "homepage": "https://github.com/rxova/react-inputs#readme"
}
