{
  "name": "rxova",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rxova React Inputs: a suite of headless, accessible React input components.",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck //#typecheck:scripts",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/.eslintcache",
    "format": "prettier --write . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "format:check": "prettier --check . --cache --cache-location node_modules/.cache/prettier/.prettiercache",
    "test": "turbo run test //#test:scripts",
    "test:coverage": "turbo run test:coverage //#test:scripts",
    "size": "turbo run size",
    "check:exports": "turbo run check:exports --concurrency=1",
    "pack:smoke": "turbo run pack:smoke --concurrency=1",
    "audit:check": "pnpm audit --audit-level=high --ignore-registry-errors",
    "dedupe:check": "pnpm dedupe --check",
    "knip:check": "knip",
    "sherif:check": "sherif --fail-on-warnings",
    "dev": "turbo run dev --filter=@rxova/playground",
    "playground:build": "turbo run build --filter=@rxova/playground",
    "storybook": "turbo run dev --filter=@rxova/storybook",
    "storybook:build": "turbo run build --filter=@rxova/storybook",
    "docs": "pnpm run docs:dev",
    "docs:dev": "turbo run dev --filter=@rxova/docs",
    "docs:build": "turbo run build --filter=@rxova/docs",
    "e2e": "turbo run e2e --concurrency=3",
    "e2e:serial": "turbo run e2e --concurrency=1",
    "test:frameworks": "turbo run compat --filter='./apps/compat-*' --concurrency=1",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "release": "turbo run build && changeset publish",
    "postpublish:smoke": "rxova-repo-config post-publish-smoke",
    "prepare": "husky",
    "check:llms": "rxova-repo-config check-llms",
    "check:tokens": "node --import tsx ./scripts/check-tokens.ts",
    "check:browsers": "node --import tsx ./scripts/check-browsers.ts",
    "check:changeset": "rxova-repo-config check-changeset",
    "verify": "rxova-repo-config verify",
    "check:snippets": "rxova-repo-config check-snippets",
    "test:scripts": "vitest run",
    "typecheck:scripts": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@rxova/docs-kit": "^0.1.1",
    "@rxova/repo-config": "^0.5.0",
    "@rxova/ts-utils": "^0.2.1",
    "@types/node": "^26.6.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.8",
    "sherif": "^1.13.0",
    "tsx": "^4.23.13",
    "turbo": "^2.10.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  },
  "repoConfig": {
    "verify": {
      "steps": [
        {
          "name": "Audit dependencies",
          "command": "pnpm run audit:check"
        },
        {
          "name": "Check dependency dedupe",
          "command": "pnpm exec turbo run //#dedupe:check"
        },
        {
          "name": "Check dependency versions across the workspace",
          "command": "pnpm run sherif:check"
        },
        {
          "name": "Check for unused files, exports and dependencies",
          "command": "pnpm run knip:check"
        },
        {
          "name": "Check formatting",
          "command": "pnpm run format:check"
        },
        {
          "name": "Check doc snippets",
          "command": "pnpm run check:snippets"
        },
        {
          "name": "Check agent llms.txt files",
          "command": "pnpm run check:llms"
        },
        {
          "name": "Check styling token namespaces",
          "command": "pnpm run check:tokens"
        },
        {
          "name": "Check e2e browser list",
          "command": "pnpm run check:browsers"
        },
        {
          "name": "Lint",
          "command": "pnpm run lint"
        },
        {
          "name": "Typecheck, test, build and size budgets",
          "command": "pnpm exec turbo run typecheck test:coverage build size //#typecheck:scripts //#test:scripts"
        },
        {
          "name": "Check package publishing metadata",
          "command": "pnpm run check:exports"
        },
        {
          "name": "Smoke-test the package tarball",
          "command": "pnpm run pack:smoke"
        }
      ]
    },
    "changeset": {
      "singlePackage": true,
      "scope": "shipped"
    },
    "llms": {
      "api": "props"
    },
    "packages": {
      "marker": "rxova.slug"
    },
    "postPublish": {
      "importPattern": "^@rxova/react-",
      "peers": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
      }
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "pnpm@12.5.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rxova/react-inputs.git"
  },
  "bugs": {
    "url": "https://github.com/rxova/react-inputs/issues"
  },
  "homepage": "https://github.com/rxova/react-inputs#readme"
}
