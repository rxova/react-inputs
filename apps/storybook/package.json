{
  "name": "@rxova/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Component workshop: Storybook stories for every rxova input, driven from package source.",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build -o dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run"
  },
  "dependencies": {
    "@rxova/react-date-input": "workspace:*",
    "@rxova/react-file-input": "workspace:*",
    "@rxova/react-intl-currency-input": "workspace:*",
    "@rxova/react-otp-input": "workspace:*",
    "@rxova/react-password-input": "workspace:*",
    "@rxova/react-phone-input": "workspace:*",
    "@rxova/react-rating-input": "workspace:*",
    "@rxova/react-tags-input": "workspace:*",
    "@rxova/react-time-input": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.0",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
