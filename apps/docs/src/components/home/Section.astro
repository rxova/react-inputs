---
/**
 * A landing-page section: eyebrow, heading, lede, then whatever the page puts
 * in the slot.
 *
 * `not-content` is the important part. Starlight's markdown.css scopes every
 * prose rule with `:where(.not-content *)` exclusions, so without it these
 * sections inherit the docs' content gap and type scale and the page reads as
 * documentation again — which is the thing this redesign is undoing.
 */
interface Props {
  id?: string
  eyebrow?: string
  title: string
  lede?: string
  /** Draws the gradient hairline above the heading. Reserved for the proof band. */
  accent?: boolean
}

const { id, eyebrow, title, lede, accent = false } = Astro.props
---

<section class:list={['rx-sec', 'not-content', { 'rx-sec--accent': accent }]} id={id}>
  <header class="rx-sec__head">
    {eyebrow && <p class="rx-sec__eyebrow">{eyebrow}</p>}
    <h2 class="rx-sec__title">{title}</h2>
    {lede && <p class="rx-sec__lede">{lede}</p>}
  </header>
  <slot />
</section>

<style>
  /* Unlayered, so this beats Starlight's `.sl-container > * + *` gap (which
     lives in @layer starlight.core) without needing a specificity fight. */
  .rx-sec {
    margin-block: 5.5rem 0;
  }

  /* rem, not ch. `ch` resolves against the element's OWN font-size, and this is
     a 1rem block wrapping a ~2.35rem heading — so `52ch` came out around 416px
     and broke short titles onto a second line with a single orphaned word
     ("…Edit / it."). A rem bound is the measure that was actually intended. */
  .rx-sec__head {
    max-width: 48rem;
    margin-bottom: 2rem;
  }

  .rx-sec__eyebrow {
    margin: 0 0 0.75rem;
    /* --rx-muted, not --rx-faint: faint on the card is ~3.4:1 and fails AA here. */
    color: var(--rx-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .rx-sec__title {
    margin: 0;
    color: var(--rx-fg);
    font-size: clamp(1.6rem, 1.15rem + 1.7vw, 2.35rem);
    font-weight: 640;
    line-height: 1.15;
    letter-spacing: -0.02em;
    /* A wrapping title splits evenly instead of orphaning its last word. */
    text-wrap: balance;
  }

  .rx-sec__lede {
    max-width: 62ch;
    margin: 0.9rem 0 0;
    color: var(--rx-muted);
    font-size: 1.05rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  /* The brand's rule is that the logo gradient is the only chroma and earns at
     most one placement per surface. This is that placement. */
  .rx-sec--accent .rx-sec__head {
    padding-top: 1.75rem;
    border-top: 2px solid transparent;
    border-image: var(--rx-gradient) 1;
  }

  /* Starlight's own `pre` styling lives in markdown.css, every rule of which
     excludes `:where(.not-content *)` — so a fenced block slotted into a
     section arrives with Shiki's inline colours and no box at all. Give it the
     same frame the rest of the page uses. */
  /* Direct children only. A descendant selector here would outrank the child
     components' own scoped rules — `.rx-sec p` is (0,1,1) against
     `.rx-stats__value` at (0,1,0) — and repaint every stat value as muted body
     copy. The slotted markdown is a direct child; their internals are not. */
  .rx-sec > :global(pre) {
    margin: 0;
    padding: 1.1rem 1.25rem;
    background: var(--rx-card);
    border: 1px solid var(--rx-rule);
    border-radius: var(--rx-radius);
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.65;
  }

  /* Prose that follows a slotted component — the "see the whole suite" line. */
  .rx-sec > :global(p) {
    margin: 1.5rem 0 0;
    color: var(--rx-muted);
    font-size: 0.98rem;
    line-height: 1.62;
  }

  .rx-sec > :global(p a) {
    color: var(--rx-primary);
    font-weight: 500;
  }

  @media (min-width: 50rem) {
    .rx-sec {
      margin-block: 7rem 0;
    }
  }
</style>
