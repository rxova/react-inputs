---
import { frameworkCompatibility } from '../lib/framework-proof.mjs'
---

<div class="sl-table-wrapper">
  <table>
    <thead>
      <tr>
        <th>Framework</th>
        <th>Tested dependency range</th>
        <th>Rendering path</th>
        <th>Browser proof</th>
      </tr>
    </thead>
    <tbody>
      {frameworkCompatibility.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>
            <code>{row.version}</code>
          </td>
          <td>{row.rendering}</td>
          <td>{row.coverage}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
